# Financial Engine — trusts Shared-Auth-Service
APP_NAME=Financial Engine
APP_ENV=development
DEBUG=true

# MUST match Shared-Auth-Service SECRET_KEY
SECRET_KEY=change-me-to-a-long-random-shared-secret-across-all-apps

# Local finance DB
DATABASE_URL=postgresql://stem:stem_secret@localhost:5432/financial_engine

IAM_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_SLUG=financial-engine
